<?php

/**
 * @file
 * Domain availability lookups across many TLDs, in parallel.
 *
 * Every hook here is a thin delegate to a class in src/Hook/, and every one
 * carries #[LegacyHook]. That attribute is how Drupal 11.1 and later know to
 * skip the procedural function because an object-oriented implementation of the
 * same hook exists, so the work is never done twice.
 *
 * The functions cannot simply be deleted, because the module supports Drupal
 * 10.3, where object-oriented hooks are not dispatched at all — core's own
 * Hook attribute on that branch documents itself as having no effect before
 * Drupal 11.1, and HookCollectorPass does not exist there. On 10.3 these
 * functions are the implementation; on 11.1+ they are dead weight that costs
 * nothing. Either way the logic lives in the class, once.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\domain_availability\Hook\DomainAvailabilityHelp;
use Drupal\domain_availability\Hook\DomainAvailabilityMail;
use Drupal\domain_availability\Hook\DomainAvailabilityTheme;
use Drupal\domain_availability\Hook\DomainAvailabilityThemePreprocess;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function domain_availability_help(string $route_name, RouteMatchInterface $route_match): string {
  return \Drupal::classResolver(DomainAvailabilityHelp::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function domain_availability_theme(): array {
  return \Drupal::classResolver(DomainAvailabilityTheme::class)->theme();
}

/**
 * Implements hook_preprocess_HOOK() for domain_availability_results.
 */
#[LegacyHook]
function domain_availability_preprocess_domain_availability_results(array &$variables): void {
  \Drupal::classResolver(DomainAvailabilityThemePreprocess::class)->preprocessResults($variables);
}

/**
 * Implements hook_mail().
 */
#[LegacyHook]
function domain_availability_mail(string $key, array &$message, array $params): void {
  \Drupal::classResolver(DomainAvailabilityMail::class)->mail($key, $message, $params);
}
